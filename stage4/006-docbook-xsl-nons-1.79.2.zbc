pkgdir=[docbook-xsl-nons-1.79.2]
pkgname=[docbook-xsl-nons]
pkgver=[1.79.2]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://github.com/docbook/xslt10-stylesheets/releases/download/release/1.79.2/docbook-xsl-nons-1.79.2.tar.bz2]
md5sum=[2666d1488d6ced1551d15f31d7ed8c38]

patchurl=[https://www.linuxfromscratch.org/patches/blfs/svn/docbook-xsl-nons-1.79.2-stack_fix-1.patch]
patchmd5=[8457bd6ee6b06fbc6dc540e1b096f766]

docurl=[https://github.com/docbook/xslt10-stylesheets/releases/download/release/1.79.2/docbook-xsl-doc-1.79.2.tar.bz2]
docmd5=[62375ca864fc198cb2b17d98209d0b8c]

prepare=[tar -xf $SOURCES/docbook-xsl-doc-1.79.2.tar.bz2 --strip-components=1]

build=[install -v -m755 -d /usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2 &&
  cp -v -R VERSION assembly common eclipse epub epub3 extensions fo \
         highlighting html htmlhelp images javahelp lib manpages params  \
         profiling roundtrip slides template tests tools webhelp website \
         xhtml xhtml-1_1 xhtml5 \
    /usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2
]

install=[ln -s VERSION /usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2/VERSION.xsl &&
  install -v -m644 -D README /usr/share/doc/docbook-xsl-nons-1.79.2/README.txt &&
  install -v -m644    RELEASE-NOTES* NEWS* /usr/share/doc/docbook-xsl-nons-1.79.2
  cp -v -R doc/* /usr/share/doc/docbook-xsl-nons-1.79.2
]

post=[. $SOURCES/zbuild_docbook-xsl-nons.sh]
