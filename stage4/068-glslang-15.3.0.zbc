pkgdir=[glslang-15.3.0]
pkgname=[glslang]
pkgver=[15.3.0]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://github.com/KhronosGroup/glslang/archive/15.3.0/glslang-15.3.0.tar.gz]
md5sum=[fd77b2aa1b1f42d8c0a43502f305e153]

prepare=[cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release \
  -D ALLOW_EXTERNAL_SPIRV_TOOLS=ON -D BUILD_SHARED_LIBS=ON -D GLSLANG_TESTS=ON -G Ninja
]

build=[cd build && ninja]

check=[cd build && ninja test]

install=[cd build && ninja install]
