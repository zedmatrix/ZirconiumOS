pkgdir=[SPIRV-Tools-vulkan-sdk-1.4.313.0]
pkgname=[SPIRV-Tools-vulkan-sdk]
pkgver=[1.4.313.0]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://github.com/KhronosGroup/SPIRV-Tools/archive/vulkan-sdk-1.4.313.0/SPIRV-Tools-vulkan-sdk-1.4.313.0.tar.gz]
md5sum=[583ee1cff84d74ac218b7b4b1dec831f]

prepare=[cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release \
  -D SPIRV_WERROR=OFF -D BUILD_SHARED_LIBS=ON -D SPIRV_TOOLS_BUILD_STATIC=OFF \
  -D SPIRV-Headers_SOURCE_DIR=/usr -G Ninja
]

build=[cd build && ninja]

check=[cd build && ninja test]

install=[cd build && ninja install]
