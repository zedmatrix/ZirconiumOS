pkgdir=[shared-mime-info-2.4]
pkgname=[shared-mime-info]
pkgver=[2.4]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/2.4/shared-mime-info-2.4.tar.gz]
md5sum=[aac56db912b7b12a04fb0018e28f2f36]

docurl=[https://anduin.linuxfromscratch.org/BLFS/xdgmime/xdgmime.tar.xz]
docmd5=[7dfb4446705d345d3acd672024049e86]

preconfig=[tar -xf $SOURCES/xdgmime.tar.xz &&
  make -C xdgmime
]

prepare=[meson setup build --prefix=/usr --buildtype=release -D update-mimedb=true]

build=[cd build && ninja]

check=[cd build && ninja test]

install=[cd build && ninja install]
