pkgdir=[rustc-1.87.0-src]
pkgname=[rustc]
pkgver=[1.87.0]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://static.rust-lang.org/dist/rustc-1.87.0-src.tar.xz]
md5sum=[dace019fa53452f321b93d34a37f995d]

preconfig=[mkdir -pv /opt/rustc-1.87.0 &&
  ln -svfn rustc-1.87.0 /opt/rustc
]

prepare=[cp -v $SOURCES/zbuild_rustc.toml bootstrap.toml]

build=[export LIBSSH2_SYS_USE_PKG_CONFIG=1 &&
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 &&
  ./x.py build
]

check=[./x.py test --verbose --no-fail-fast | tee rustc-testlog]

install=[./x.py install]

post=[rm -fv /opt/rustc-1.87.0/share/doc/rustc-1.87.0/*.old &&
  install -vm644 README.md /opt/rustc-1.87.0/share/doc/rustc-1.87.0 &&
  install -vdm755 /usr/share/zsh/site-functions &&
  ln -sfv /opt/rustc/share/zsh/site-functions/_cargo /usr/share/zsh/site-functions
  mv -v /etc/bash_completion.d/cargo /usr/share/bash-completion/completions
]

postconfig=[grep '^test result:' rustc-testlog | awk '{sum1 += $4; sum2 += $6} END { print sum1 " passed; " sum2 " failed" }' &&
  cat >> /etc/profile.d/extrapaths.sh << "EOF"
# /opt/rustc addition
pathprepend /opt/rustc/bin           PATH

EOF
]
