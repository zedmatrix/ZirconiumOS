pkgdir=[links-2.30]
pkgname=[links]
pkgver=[2.30]
pkgrel=[1]
zarchive=[true]

pkgurl=[http://links.twibright.com/download/links-2.30.tar.bz2]
md5sum=[dc56041551980c74dd354cd7c2882539]

build=[./configure --prefix=/usr --mandir=/usr/share/man && make]

install=[make install]

