pkgdir=[yasm-1.3.0]
pkgname=[yasm]
pkgver=[1.3.0]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://www.tortall.net/projects/yasm/releases/yasm-1.3.0.tar.gz]
md5sum=[fc9e586751ff789b34b1f21d572d96af]

preconfig=[sed -e 's/def __cplusplus/ defined(__cplusplus) || __STDC_VERSION__ >= 202311L/' -i libyasm/bitvect.h]

prepare=[sed -i 's#) ytasm.*#)#' Makefile.in && ./configure --prefix=/usr]

build=[make]

check=[make -j1 check]

install=[make install]
