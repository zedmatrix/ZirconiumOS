pkgdir=[graphviz-13.0.1]
pkgname=[graphviz]
pkgver=[13.0.1]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://gitlab.com/graphviz/graphviz/-/archive/13.0.1/graphviz-13.0.1.tar.bz2]
md5sum=[ac6973d38c143ca9e537959b84ce2642]

prepare=[cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release]

build=[sed -i '/GZIP/s/:.*$/=/' build/CMakeCache.txt && cmake --build build]

install=[cmake --install build]
