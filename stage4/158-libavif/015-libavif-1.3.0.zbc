pkgdir=[libavif-1.3.0]
pkgname=[libavif]
pkgver=[1.3.0]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://github.com/AOMediaCodec/libavif/archive/v1.3.0/libavif-1.3.0.tar.gz]
md5sum=[e180551c0989f7e096a4440b89d6282d]

prepare=[cmake -B build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release -D AVIF_CODEC_AOM=SYSTEM \
  -D AVIF_BUILD_GDK_PIXBUF=ON -D AVIF_LIBYUV=OFF -G Ninja
]

build=[cmake --build build]

install=[cmake --install build]

post=[gdk-pixbuf-query-loaders --update-cache]
