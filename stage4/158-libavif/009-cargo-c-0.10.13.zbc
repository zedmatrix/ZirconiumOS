pkgdir=[cargo-c-0.10.13]
pkgname=[cargo-c]
pkgver=[0.10.13]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://github.com/lu-zero/cargo-c/archive/v0.10.13/cargo-c-0.10.13.tar.gz]
md5sum=[cb5609d8f6254d132d0226319935138d]

prepare=[curl -fLO https://github.com/lu-zero/cargo-c/releases/download/v0.10.13/Cargo.lock]

build=[export LIBSSH2_SYS_USE_PKG_CONFIG=1 &&
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1 &&
  cargo build --release
]

check=[cargo test --release]

install=[install -vm755 target/release/cargo-{capi,cbuild,cinstall,ctest} /usr/bin/]
