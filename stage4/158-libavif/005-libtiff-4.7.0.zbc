pkgdir=[tiff-4.7.0]
pkgname=[libtiff]
pkgver=[4.7.0]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://download.osgeo.org/libtiff/tiff-4.7.0.tar.gz]
md5sum=[3a0fa4a270a4a192b08913f88d0cfbdd]

prepare=[cmake -B libtiff-build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -D CMAKE_INSTALL_DOCDIR=/usr/share/doc/libtiff-4.7.0 -G Ninja
]

build=[cmake --build libtiff-build]

check=[cmake --test libtiff-build]

install=[cmake --install libtiff-build]
