pkgdir=[libaom-3.12.1]
pkgname=[libaom]
pkgver=[3.12.1]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://storage.googleapis.com/aom-releases/libaom-3.12.1.tar.gz]
md5sum=[51e4e369c41f66d2f8f1ed83e2206908]

prepare=[cmake -B aom-build -D CMAKE_INSTALL_PREFIX=/usr -D CMAKE_BUILD_TYPE=Release  \
  -D BUILD_SHARED_LIBS=1 -D ENABLE_DOCS=no -G Ninja
]

build=[cd aom-build && ninja]

install=[cd aom-build && ninja install]

post=[rm -v /usr/lib/libaom.a]
