pkgdir=[graphite2-1.3.14-pass1]
pkgname=[graphite2]
pkgver=[1.3.14]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://github.com/silnrsi/graphite/releases/download/1.3.14/graphite2-1.3.14.tgz]
md5sum=[1bccb985a7da01092bfb53bb5041e836]

preconfig=[sed -i '/cmptest/d' tests/CMakeLists.txt &&
  sed -i '/cmake_policy(SET CMP0012 NEW)/d' CMakeLists.txt &&
  sed -i 's/PythonInterp/Python3/' CMakeLists.txt &&
  find . -name CMakeLists.txt | xargs sed -i 's/VERSION 2.8.0 FATAL_ERROR/VERSION 4.0.0/' &&
  sed -i '/Font.h/i #include <cstdint>' tests/featuremap/featuremaptest.cpp
]

prepare=[cmake -B build -D CMAKE_INSTALL_PREFIX=/usr]

build=[cd build && make]

check=[cd build && make test]

install=[cd build && make install]
