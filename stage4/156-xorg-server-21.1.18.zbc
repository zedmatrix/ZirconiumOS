pkgdir=[xorg-server-21.1.18]
pkgname=[xorg-server]
pkgver=[21.1.18]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://www.x.org/pub/individual/xserver/xorg-server-21.1.18.tar.xz]
md5sum=[43225ddc1fd8d7ae7671c25ab6d1f927]

patchurl=[https://www.linuxfromscratch.org/patches/blfs/svn/xorg-server-21.1.18-tearfree_backport-1.patch]
patchmd5=[6834d533bf96fb12f1a340ac55503d7b]

prepare=[meson setup build --prefix=/usr --localstatedir=/var -D glamor=true -D xkb_output_dir=/var/lib/xkb]

build=[meson compile -C build]

check=[/sbin/ldconfig && meson test -C build]

install=[meson install -C build]

post=[mkdir -pv /etc/X11/xorg.conf.d]
