pkgdir=[systemd-257.6]
pkgname=[systemd]
pkgver=[257.6]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://github.com/systemd/systemd/archive/v257.6/systemd-257.6.tar.gz]
md5sum=[458b07e140cd65d25baf7752398c5d13]

preconfig=[sed -i -e 's/GROUP="render"/GROUP="video"/' -e 's/GROUP="sgx", //' rules.d/50-udev-default.rules.in]

prepare=[meson setup build --prefix=/usr --buildtype=release -D default-dnssec=no -D firstboot=false \
  -D install-tests=false -D ldconfig=false -D man=auto -D sysusers=false -D rpmmacrosdir=no -D homed=disabled \
  -D userdb=false -D mode=release -D pam=enabled -D pamconfdir=/etc/pam.d -D dev-kvm-mode=0660 -D nobody-group=nogroup \
  -D sysupdate=disabled -D ukify=disabled -D docdir=/usr/share/doc/systemd-257.6
]

build=[meson compile -C build]

check=[meson test -C build]

install=[meson install -C build]

post=[. $SOURCES/zbuild-systemd-conf.sh]
