pkgdir=[xterm-400]
pkgname=[xterm]
pkgver=[400]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://invisible-mirror.net/archives/xterm/xterm-400.tgz]
md5sum=[a60f7950e38d16d7fc0e8cf80070354b]

preconfig=[sed -i '/v0/{n;s/new:/new:kb=^?:/}' termcap && printf '\tkbs=\\177,\n' >> terminfo]

prepare=[TERMINFO=/usr/share/terminfo ./configure --prefix=/usr \
 --sysconfdir=/etc --localstatedir=/var --disable-static --with-app-defaults=/etc/X11/app-defaults]

build=[make]

install=[make install]

post=[mkdir -pv /usr/share/applications && cp -v *.desktop /usr/share/applications/]

postconfig=[cat >> /etc/X11/app-defaults/XTerm << "EOF"
*VT100*locale: true
*VT100*faceName: Monospace
*VT100*faceSize: 10
*backarrowKeyIsErase: true
*ptyInitialErase: true
EOF
]
