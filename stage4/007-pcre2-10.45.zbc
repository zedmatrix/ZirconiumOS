pkgdir=[pcre2-10.45]
pkgname=[pcre2]
pkgver=[10.45]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.45/pcre2-10.45.tar.bz2]
md5sum=[f71abbe1b5adf25cd9af5d26ef223b66]

prepare=[./configure --prefix=/usr --docdir=/usr/share/doc/pcre2-10.45 --enable-unicode --enable-jit \
  --enable-pcre2-16 --enable-pcre2-32 --enable-pcre2grep-libz --enable-pcre2grep-libbz2 \
  --enable-pcre2test-libreadline --disable-static
]

build=[make]

check=[make check]

install=[make install]
