pkgdir=[docbook-xml-4.5]
pkgname=[docbook-xml]
pkgver=[4.5]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://www.docbook.org/xml/4.5/docbook-xml-4.5.zip]
md5sum=[03083e288e87a7e829e437358da7ef9e]

build=[install -v -d -m755 /usr/share/xml/docbook/xml-dtd-4.5 &&
  install -v -d -m755 /etc/xml  &&
  cp -v -af --no-preserve=ownership docbook.cat *.dtd ent/ *.mod /usr/share/xml/docbook/xml-dtd-4.5
]

install=[. $SOURCES/zbuild_docbook-xml-4.5.sh]
