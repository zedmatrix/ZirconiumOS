pkgdir=[rust-bindgen-0.72.0]
pkgname=[rust-bindgen]
pkgver=[0.72.0]
pkgrel=[1]
zarchive=[false]
pkgurl=[https://github.com/rust-lang/rust-bindgen/archive/v0.72.0/rust-bindgen-0.72.0.tar.gz]
md5sum=[15888c0e5c60a1d367cf6c1b6e51c067]

build=[cargo build --release]

check=[cargo test --release]

install=[install -Dm755 target/release/bindgen /usr/bin/]

post=[bindgen --generate-shell-completions bash > /usr/share/bash-completion/completions/bindgen &&
  bindgen --generate-shell-completions zsh > /usr/share/zsh/site-functions/_bindgen
]
