# REQUIRED
pkgdir=[libarchive-3.8.1]
pkgname=[libarchive]
pkgver=[3.8.1]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://github.com/libarchive/libarchive/releases/download/v3.8.1/libarchive-3.8.1.tar.xz]
