pkgdir=[fuse-3.17.2]
pkgname=[fuse]
pkgver=[3.17.2]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://github.com/libfuse/libfuse/releases/download/fuse-3.17.2/fuse-3.17.2.tar.gz]
md5sum=[55c21312d50b20190807bf053a08c558]

preconfig=[sed -i '/^udev/,$ s/^/#/' util/meson.build]

prepare=[meson setup build --prefix=/usr --buildtype=release]

build=[meson compile -C build]

check=[]

# REQUIRED
install=[meson install -C build]

post=[chmod u+s /usr/bin/fusermount3]

postconfig=[cp -Rv doc/html -T /usr/share/doc/fuse-3.17.2 &&
  install -v -m644   doc/{README.NFS,kernel.txt} /usr/share/doc/fuse-3.17.2
]
