pkgdir=[freetype-2.13.3-pass1]
pkgname=[freetype]
pkgver=[2.13.3]
pkgrel=[1]
zarchive=[false]

pkgurl=[https://downloads.sourceforge.net/freetype/freetype-2.13.3.tar.xz]
md5sum=[f3b4432c4212064c00500e1ad63fbc64]

docurl=[https://downloads.sourceforge.net/freetype/freetype-doc-2.13.3.tar.xz]
docmd5=[6affe0d431939398cc3c7cdd58d824f8]

preconfig=[sed -ri "s:.*(AUX_MODULES.*valid):\1:" modules.cfg &&
  sed -r "s:.*(#.*SUBPIXEL_RENDERING) .*:\1:" -i include/freetype/config/ftoption.h
]

prepare=[./configure --prefix=/usr --without-harfbuzz --enable-freetype-config --disable-static]

build=[make]

install=[make install]

post=[tar -xf $SOURCES/freetype-doc-2.13.3.tar.xz --strip-components=2 -C docs]
postconfig=[cp -v -R docs -T /usr/share/doc/freetype-2.13.3 &&
  rm -v /usr/share/doc/freetype-2.13.3/freetype-config.1
]
