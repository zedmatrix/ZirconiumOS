pkgdir=[git-2.50.0]
pkgname=[git]
pkgver=[2.50.0]
pkgrel=[1]
zarchive=[true]

pkgurl=[https://www.kernel.org/pub/software/scm/git/git-2.50.0.tar.xz]
md5sum=[6e43781d11b99031e18593f44d39313a]

build=[./configure --prefix=/usr --with-gitconfig=/etc/gitconfig --with-python=python3 && make]

check=[GIT_UNZIP=nonexist make test -k |& tee test.log]

install=[make perllibdir=/usr/lib/perl5/5.40/site_perl install]

post=[grep '^not ok' test.log | grep -v TODO || true]
