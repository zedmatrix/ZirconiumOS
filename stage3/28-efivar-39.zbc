pkgdir=[efivar-39]
pkgname=[efivar]
pkgver=[39]
pkgrel=[1]
zarchive=[true]

# Only One - Needed
pkgurl=[https://github.com/rhboot/efivar/archive/39/efivar-39.tar.gz]
